# ----------------------------------------------------------------------------
# CollegeHub backend environment
# Copy to .env and adjust. NEVER commit real secrets.
# ----------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000

# MongoDB connection string (Atlas or self-hosted)
MONGODB_URI=mongodb://127.0.0.1:27017/collegehub

# Auth
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-access
JWT_REFRESH_SECRET=change-me-to-a-long-random-string-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false

# Comma-separated list of extra allowed origins for CORS (the app itself is
# served same-origin in production, so this is normally empty in production)
CORS_ORIGINS=

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Seed the first administrator (npm run bootstrap:admin)
ADMIN_NAME=College Administrator
ADMIN_EMAIL=admin@pdpscollege.edu.in
ADMIN_PASSWORD=ChangeMe123!

# Optional: demo data seeding (npm run seed:demo)
SEED_DEMO_DATA=false
